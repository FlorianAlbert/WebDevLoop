@using WebDevLoop.Core.Domain
@using WebDevLoop.Core.Queries

<SectionCard Title="Integration saga" data-testid="saga">
    @if (Saga is null)
    {
        <p class="quiet-note">No integration has started for this ticket.</p>
    }
    else
    {
        <ol class="list-inline mb-2">
            @foreach (IntegrationSagaCheckpoint checkpoint in Enum.GetValues<IntegrationSagaCheckpoint>())
            {
                string state = checkpoint < Saga.Checkpoint ? "done" : checkpoint == Saga.Checkpoint ? "current" : "pending";
                <li class="list-inline-item" data-testid="saga-step-@checkpoint" data-state="@state"><StatusPill Variant="StateVariant(state)">@DisplayNames.Humanize(checkpoint.ToString())</StatusPill></li>
            }
        </ol>
        <p class="small mb-0">
            Stack branch <code>@Saga.StackBranch</code>@(Saga.PullRequestNumber is { } pr ? $", PR #{pr}" : "").
            Updated <AppDateTime Value="Saga.UpdatedAt" />.
        </p>
        @if (Saga.LastError is { } error)
        {
            <p class="alert alert-danger mt-2" data-testid="saga-error">@error</p>
        }
    }
</SectionCard>

@code {
    [Parameter] public IntegrationSagaView? Saga { get; set; }

    private static StatusVariant StateVariant(string state) => state switch
    {
        "done" => StatusVariant.Success,
        "current" => StatusVariant.Info,
        _ => StatusVariant.Neutral,
    };
}
