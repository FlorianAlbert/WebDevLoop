@inherits LayoutComponentBase
@using WebDevLoop.Web.Components.Dashboard
@using WebDevLoop.Web.Components.GitHub

<a class="skip-link" href="#main-content">Skip to content</a>

<div class="app-shell">
    <NavMenu />

    <main id="main-content" class="app-main" tabindex="-1">
        <div class="app-content">
            <GitHubSignInBanner />
            <DiagnosticBanner />
            @Body
        </div>
    </main>
</div>

<div id="blazor-error-ui" role="alert" data-nosnippet>
    <span class="error-ui__message"><strong>Something went wrong.</strong> Reload the page to carry on.</span>
    <a href="." class="reload btn btn-outline-secondary btn-sm">Reload</a>
    <button type="button" class="dismiss" aria-label="Dismiss"><Icon Name="close" Size="16" /></button>
</div>
