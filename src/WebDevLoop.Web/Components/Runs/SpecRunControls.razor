@using WebDevLoop.Core.Domain
@using WebDevLoop.Core.Queries

<RunControlPanel Commands="Commands" OnApplied="OnChanged" />

@code {
    [Parameter, EditorRequired] public SpecRunView Spec { get; set; } = default!;

    /// <summary>The spec's tickets, so the abort command can name the open ones.</summary>
    [Parameter] public IReadOnlyList<TicketRunView> Tickets { get; set; } = [];

    /// <summary>When set, only the buttons this reason lists are offered, worded as it words them.</summary>
    [Parameter] public AttentionReason? Attention { get; set; }

    [Parameter] public EventCallback OnChanged { get; set; }

    private IReadOnlyList<RunControlCommand> Commands => SpecRunCommands.Build(Spec, Tickets, Attention);
}
