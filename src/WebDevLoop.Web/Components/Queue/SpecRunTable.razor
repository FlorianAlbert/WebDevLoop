@if (Runs.Count > 0)
{
    <div class="table-responsive">
    <table class="table table-sm table-hover align-middle mb-0">
        <tbody>
            @foreach (SpecRunView run in Runs)
            {
                SpecDependencyMode mode = run.DependencyModeUsed ?? EffectiveDependencyMode;
                <tr data-run-id="@run.Id">
                    <td class="text-body-secondary text-nowrap">#@run.ParentIssueNumber</td>
                    <td>@run.Title</td>
                    <td class="@(run.Status == SpecRunStatus.NeedsAttention ? "" : "text-nowrap")">
                        <SpecStatusBadge Status="run.Status" />
                        @if (run.Status == SpecRunStatus.WaitingForDependency)
                        {
                            <span class="small text-body-secondary" title="@DisplayNames.Describe(mode)">Mode: @DisplayNames.For(mode)</span>
                        }
                        @if (run.Status == SpecRunStatus.NeedsAttention)
                        {
                            <div class="small mt-1 queue-attention" data-testid="run-attention-@run.Id">@SpecRunDisplay.Note(run, EffectiveDependencyMode)</div>
                        }
                    </td>
                    <td class="small text-body-secondary" data-testid="run-note-@run.Id">
                        @if (run.Status == SpecRunStatus.NeedsAttention)
                        {
                            <a href="@UiRoutes.Run(run.Id)">@AttentionDisplay.CallToAction(run.Attention)</a>
                        }
                        else
                        {
                            @SpecRunDisplay.Note(run, EffectiveDependencyMode, Dependencies.GetValueOrDefault(run.Id))
                        }
                    </td>
                    <td class="text-end"><a href="@UiRoutes.Run(run.Id)">Details</a></td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<SpecRunView> Runs { get; set; } = [];

    /// <summary>Blocking specs per blocked spec run id, for the waiting note.</summary>
    [Parameter]
    public IReadOnlyDictionary<string, IReadOnlyList<SpecDependencyView>> Dependencies { get; set; } = new Dictionary<string, IReadOnlyList<SpecDependencyView>>();

    /// <summary>Used for waiting runs that have not recorded a dependency mode yet.</summary>
    [Parameter]
    public SpecDependencyMode EffectiveDependencyMode { get; set; } = SpecDependencyMode.WaitForMerge;
}
