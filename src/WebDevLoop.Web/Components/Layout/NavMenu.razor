@using WebDevLoop.Web.Components.Repositories

<aside class="app-sidebar">
    <div class="app-sidebar__bar">
        <a class="app-brand" href="@UiRoutes.Dashboard">
            <img class="app-brand__mark" src="favicon.svg" alt="" width="28" height="28" />
            <span>WebDevLoop</span>
        </a>
        <button class="app-nav-toggle" type="button" aria-controls="main-nav" aria-expanded="@(_open ? "true" : "false")"
                aria-label="Toggle navigation" @onclick="Toggle">
            <Icon Name="@(_open ? "close" : "menu")" Size="20" />
        </button>
    </div>
    <div id="main-nav" class="app-sidebar__panel @(_open ? "is-open" : null)">
        <div class="app-context">
            <RepositorySwitcher />
        </div>
        <nav aria-label="Main">
            <ul class="app-nav" @onclick="Close">
                <li><NavLink class="nav-link" href="@UiRoutes.Dashboard" Match="NavLinkMatch.All"><Icon Name="dashboard" /> Dashboard</NavLink></li>
                <li><NavLink class="nav-link" href="@UiRoutes.Repositories"><Icon Name="repositories" /> Repositories</NavLink></li>
                <li><NavLink class="nav-link" href="@UiRoutes.Queue"><Icon Name="queue" /> Queue</NavLink></li>
                <li><NavLink class="nav-link" href="@UiRoutes.Settings"><Icon Name="settings" /> Settings</NavLink></li>
                <li><NavLink class="nav-link" href="@UiRoutes.GitHub"><Icon Name="github" /> GitHub</NavLink></li>
                <li><NavLink class="nav-link" href="@UiRoutes.Health"><Icon Name="health" /> Health</NavLink></li>
            </ul>
        </nav>
        <div class="app-sidebar__footer">
            <ThemeToggle />
        </div>
    </div>
</aside>

@code {
    private bool _open;

    private void Toggle() => _open = !_open;

    private void Close() => _open = false;
}
