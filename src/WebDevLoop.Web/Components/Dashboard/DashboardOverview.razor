@inherits LiveComponentBase

<PageHeader Title="Dashboard" Description="Active, waiting and finished specs across your repositories." />

@if (!IsLoaded)
{
    <div class="placeholder-glow" role="status" aria-busy="true">
        <span class="placeholder col-12 mb-2" style="height: 4rem"></span>
        <span class="placeholder col-12" style="height: 8rem"></span>
        <span class="visually-hidden">Loading…</span>
    </div>
}
else if (LoadError is not null)
{
    <div class="alert alert-danger" role="alert">Could not load the dashboard: @LoadError</div>
}
else if (_overviews.Count == 0)
{
    <EmptyState Icon="inbox" Title="No repositories added yet" Text="Add a repository to start queueing specs.">
        <Action><a class="btn btn-primary btn-sm" href="@UiRoutes.Repositories">Add repository</a></Action>
    </EmptyState>
}
else
{
    @foreach (RunAlert alert in Alerts(SpecRunLane.NeedsAttention))
    {
        <div class="alert alert-warning py-2 d-flex flex-wrap justify-content-between align-items-center gap-2" role="alert" data-alert="NeedsAttention">
            <span>
                <strong>Needs attention:</strong> @alert.RepositoryName #@alert.Run.ParentIssueNumber “@alert.Run.Title”
                @if (AttentionDisplay.Headline(alert.Run.Attention, alert.Run.FailureReason) is { } reason)
                {
                    <span data-testid="alert-summary"> — @reason</span>
                }
            </span>
            <a class="alert-link" href="@UiRoutes.Run(alert.Run.Id)" data-testid="alert-action">@AlertAction(alert.Run)<span class="visually-hidden"> for @alert.RepositoryName #@alert.Run.ParentIssueNumber</span></a>
        </div>
    }

    @foreach (RunAlert alert in Alerts(SpecRunLane.AwaitingMerge))
    {
        <div class="alert alert-info py-2 d-flex justify-content-between align-items-center" role="status" data-alert="AwaitingMerge">
            <span>
                <strong>Awaiting merge:</strong> @alert.RepositoryName #@alert.Run.ParentIssueNumber “@alert.Run.Title”
                — @SpecRunDisplay.Note(alert.Run, SpecDependencyMode.WaitForMerge)
            </span>
            <a class="alert-link" href="@UiRoutes.Run(alert.Run.Id)">Open</a>
        </div>
    }

    <div class="d-flex flex-wrap gap-3 mb-3" role="list" aria-label="Spec counts by status">
        @foreach (SpecRunLane lane in Enum.GetValues<SpecRunLane>())
        {
            int count = Count(lane);
            <div class="card px-3 py-2 @(lane == SpecRunLane.NeedsAttention && count > 0 ? "border-warning" : null)" role="listitem" data-stat="@lane">
                <div class="small text-body-secondary">@SpecRunLanes.Title(lane)</div>
                <div class="fs-4 fw-semibold tabular @(lane == SpecRunLane.NeedsAttention && count > 0 ? "text-warning-emphasis" : null)" data-testid="count-@lane">@count</div>
            </div>
        }
    </div>

    <div class="row g-3">
        @foreach (RepositoryOverview overview in _overviews)
        {
            <div class="col-12 @(_overviews.Count > 1 ? "col-xl-6" : null)">
                <RepositoryLane Overview="overview" />
            </div>
        }
    </div>
}

@code {
    private sealed record RunAlert(string RepositoryName, SpecRunView Run);

    private IReadOnlyList<RepositoryOverview> _overviews = [];

    protected override bool ReactsTo(LiveEventView liveEvent) => SpecQueueEvents.Affects(liveEvent);

    private static string AlertAction(SpecRunView run) => AttentionDisplay.CallToAction(run.Attention);

    private int Count(SpecRunLane lane) =>
        _overviews.Sum(overview => overview.Runs.Count(run => SpecRunLanes.For(run.Status) == lane));

    private IEnumerable<RunAlert> Alerts(SpecRunLane lane) =>
        _overviews.SelectMany(overview => overview.Runs
            .Where(run => SpecRunLanes.For(run.Status) == lane)
            .Select(run => new RunAlert($"{overview.Repository.Owner}/{overview.Repository.Name}", run)));

    protected override async Task LoadAsync(CancellationToken cancellationToken) =>
        _overviews = await InScopeAsync(async services =>
        {
            IReadOnlyList<RepositoryView> repositories = await services.GetRequiredService<IRepositoryQueries>().ListAsync(cancellationToken);
            var runQueries = services.GetRequiredService<IRunQueries>();
            var settingsManager = services.GetRequiredService<ISettingsManager>();
            var overviews = new List<RepositoryOverview>();
            foreach (RepositoryView repository in repositories)
            {
                IReadOnlyList<SpecRunView> runs = await runQueries.ListSpecRunsAsync(repository.Id, cancellationToken);
                CommandResult<EffectiveSettingsView> settings = await settingsManager.GetEffectiveAsync(repository.Id, cancellationToken);
                overviews.Add(new RepositoryOverview(repository, runs, settings.Value));
            }

            return (IReadOnlyList<RepositoryOverview>)overviews;
        });
}
