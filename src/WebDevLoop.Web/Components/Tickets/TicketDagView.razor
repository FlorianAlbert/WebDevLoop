@using WebDevLoop.Core.Queries
@using WebDevLoop.Web.Components.Runs

<SectionCard Title="Tickets" data-testid="ticket-dag">
    @if (_rows.Count == 0)
    {
        <p class="quiet-note">No tickets yet.</p>
    }
    else
    {
        <div class="table-responsive">
        <table class="table table-sm align-middle mb-0 detail-table detail-table--wide">
            <thead>
                <tr><th>Layer</th><th>Ticket</th><th>Status</th><th>Blocked by</th><th>Review iteration</th><th>PR</th><th>Integration</th></tr>
            </thead>
            <tbody>
                @foreach (TicketDagRow row in _rows)
                {
                    TicketRunView ticket = row.Ticket;
                    <tr data-testid="ticket-row-@ticket.Id">
                        <td data-testid="ticket-layer-@ticket.Id">@row.Layer</td>
                        <td class="text-break"><a href="/tickets/@ticket.Id" data-testid="ticket-link-@ticket.Id">#@ticket.IssueNumber @ticket.Title</a></td>
                        <td>
                            <StatusBadge Status="@ticket.Status.ToString()" data-testid="@($"ticket-status-{ticket.Id}")" />
                            @if (row.IsFrontier)
                            {
                                <StatusPill Variant="StatusVariant.Warning" data-testid="@($"frontier-{ticket.Id}")" title="All blockers integrated: may be implemented now">Frontier</StatusPill>
                            }
                        </td>
                        <td data-testid="ticket-blockers-@ticket.Id">
                            @foreach (TicketBlocker blocker in row.Blockers)
                            {
                                <span class="me-2 @(blocker.IsSatisfied ? "text-success" : "text-body-secondary")">
                                    @(blocker.Issue is { } issue ? $"#{issue}" : blocker.TicketRunId) (@(blocker.Status is { } blockerStatus ? DisplayNames.Humanize(blockerStatus.ToString()) : "unknown"))
                                </span>
                            }
                        </td>
                        <td>@ticket.ReviewIteration</td>
                        <td>@(ticket.PullRequestNumber is { } pr ? $"#{pr}" : "–")</td>
                        <td data-testid="saga-checkpoint-@ticket.Id">@(Sagas.TryGetValue(ticket.Id, out IntegrationSagaView? saga) ? DisplayNames.Humanize(saga.Checkpoint.ToString()) : "")</td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }
</SectionCard>

@code {
    private IReadOnlyList<TicketDagRow> _rows = [];

    [Parameter, EditorRequired] public IReadOnlyList<TicketRunView> Tickets { get; set; } = [];

    [Parameter] public IReadOnlyDictionary<string, IntegrationSagaView> Sagas { get; set; } = new Dictionary<string, IntegrationSagaView>();

    protected override void OnParametersSet() => _rows = TicketDagLayout.Build(Tickets);
}
