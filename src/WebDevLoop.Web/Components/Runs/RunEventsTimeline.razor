@using WebDevLoop.Core.Queries

<section class="my-3" data-testid="run-events">
    <h2 class="h5">Events</h2>
    @if (Events.Count == 0)
    {
        <p class="text-muted">No events recorded.</p>
    }
    else
    {
        <ul class="list-unstyled small">
            @foreach (RunEventView runEvent in Events.OrderByDescending(e => e.OccurredAt).ThenByDescending(e => e.Id).Take(Limit))
            {
                <li data-testid="run-event">
                    <time>@runEvent.OccurredAt.ToString("u")</time>
                    <strong>@runEvent.Type</strong>
                    @if (runEvent.TicketRunId is { } ticket)
                    {
                        <a href="/tickets/@ticket">@ticket</a>
                    }
                </li>
            }
        </ul>
    }
</section>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<RunEventView> Events { get; set; } = [];

    [Parameter] public int Limit { get; set; } = 50;
}
