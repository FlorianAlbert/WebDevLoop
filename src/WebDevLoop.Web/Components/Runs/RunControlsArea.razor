@* Hosts the run's control buttons (SpecRunControls / TicketRunControls) as ChildContent. *@
<SectionCard Title="Controls" data-testid="run-controls">
    @if (ChildContent is not null)
    {
        @ChildContent
    }
    else
    {
        <p class="quiet-note" data-testid="controls-placeholder">No run controls are available for this @Scope.</p>
    }
</SectionCard>

@code {
    /// <summary>Names what the controls act on, e.g. "spec run".</summary>
    [Parameter, EditorRequired] public string Scope { get; set; } = string.Empty;

    [Parameter] public RenderFragment? ChildContent { get; set; }
}
