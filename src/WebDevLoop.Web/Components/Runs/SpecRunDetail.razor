@page "/runs/{Id}"
@inherits LiveDetailPageBase
@using WebDevLoop.Core.Queries
@using WebDevLoop.Web.Api
@using WebDevLoop.Web.Components.Layout
@using WebDevLoop.Web.Components.Tickets

<PageHeader Title="@(_spec?.Title ?? (IsNotFound ? "Spec run not found" : "Spec run"))" DocumentTitle="@(_spec?.Title ?? "Spec run")" />

@if (IsNotFound)
{
    <EmptyState Icon="search" Title="Nothing to show here" data-testid="not-found">
        <ChildContent>Spec run '@Id' does not exist or was removed.</ChildContent>
        <Action><a class="btn btn-primary btn-sm" href="@UiRoutes.Queue">Back to queue</a></Action>
    </EmptyState>
}
else if (_spec is not null)
{
    <div class="detail-summary">
        <StatusBadge Status="@_spec.Status.ToString()" data-testid="spec-status" />
        <span>Spec issue #@_spec.ParentIssueNumber</span>
        <span>Queue position @_spec.QueuePosition</span>
        @if (_spec.DependencyModeUsed is { } mode)
        {
            <span data-testid="dependency-mode">Mode: @DisplayNames.For(mode)</span>
        }
    </div>
    @if (_spec.FailureReason is { } failure)
    {
        <p class="alert alert-danger" data-testid="failure-reason">@failure</p>
    }

    <SectionCard Title="Details" data-testid="spec-details">
        <dl class="fact-list">
            <dt class="fact-list__label">Integration branch</dt>
            <dd class="fact-list__value" data-testid="integration-branch"><code>@_spec.IntegrationBranch</code></dd>
            <dt class="fact-list__label">Base branch</dt>
            <dd class="fact-list__value">@if (_spec.BaseBranch is { } baseBranch) { <code>@baseBranch</code> } else { <span class="text-body-secondary">–</span> }</dd>
            <dt class="fact-list__label">Integration tip</dt>
            <dd class="fact-list__value" data-testid="integration-tip"><ShortHash Value="@_spec.IntegrationTipSha" /></dd>
            <dt class="fact-list__label">Cycles</dt>
            <dd class="fact-list__value">Parent review @_spec.ReviewCycle, tester @_spec.TestCycle</dd>
            <dt class="fact-list__label">Created</dt>
            <dd class="fact-list__value"><AppDateTime Value="_spec.CreatedAt" /></dd>
        </dl>
    </SectionCard>

    <SpecBlockersPanel Blockers="_blockers" />

    <RunControlsArea Scope="spec run">
        <SpecRunControls Spec="_spec" OnChanged="RefreshAsync" />
    </RunControlsArea>

    <TicketDagView Tickets="_tickets" Sagas="_sagas" />
    <StackLayersPanel Layers="_stack" />
    <MergeTrackingPanel Status="_spec.Status" LayerCount="_stack.Count" FailureReason="_spec.FailureReason" />
    <RunEventsTimeline Events="_events" />
}

@code {
    private SpecRunView? _spec;
    private IReadOnlyList<TicketRunView> _tickets = [];
    private IReadOnlyList<StackLayerView> _stack = [];
    private IReadOnlyList<RunEventView> _events = [];
    private IReadOnlyDictionary<string, IntegrationSagaView> _sagas = new Dictionary<string, IntegrationSagaView>();
    private IReadOnlyList<SpecDependencyView> _blockers = [];

    [Parameter] public string Id { get; set; } = string.Empty;

    protected override bool IsRelevant(LiveEventView view) =>
        RunEventSubscription.Concerns(view, Id) || _blockers.Any(blocker => blocker.BlockingSpecRunId == view.SpecRunId);

    protected override async Task LoadAsync(CancellationToken cancellationToken)
    {
        var queries = ScopedServices.GetRequiredService<IRunQueries>();
        if (ApiIds.SpecRun(Id) is not { } runId || await queries.GetSpecRunAsync(runId, cancellationToken) is not { } spec)
        {
            IsNotFound = true;
            _spec = null;
            return;
        }

        IsNotFound = false;
        _spec = spec;
        _tickets = await queries.ListTicketRunsAsync(runId, cancellationToken);
        _stack = await queries.ListStackAsync(runId, cancellationToken);
        _events = await queries.ListEventsAsync(runId, cancellationToken);
        _sagas = await queries.ListLatestSagasAsync(runId, cancellationToken);
        _blockers = await queries.ListSpecDependenciesAsync(runId, cancellationToken);
    }
}
