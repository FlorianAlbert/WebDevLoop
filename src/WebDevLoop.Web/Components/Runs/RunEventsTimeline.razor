@using WebDevLoop.Core.Queries

<SectionCard Title="Events" data-testid="run-events">
    @if (Events.Count == 0)
    {
        <p class="quiet-note" data-testid="no-events">No events recorded.</p>
    }
    else
    {
        <ul class="list-unstyled small mb-0">
            @foreach (RunEventView runEvent in Events.OrderByDescending(e => e.OccurredAt).ThenByDescending(e => e.Id).Take(Limit))
            {
                <li class="d-flex flex-wrap align-items-baseline gap-2 py-1" data-testid="run-event">
                    <span class="text-body-secondary"><AppDateTime Value="runEvent.OccurredAt" Mode="DateTimeDisplay.Absolute" /></span>
                    <strong>@runEvent.Type</strong>
                    @if (runEvent.TicketRunId is { } ticket)
                    {
                        <a href="/tickets/@ticket">@ticket</a>
                    }
                </li>
            }
        </ul>
    }
</SectionCard>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<RunEventView> Events { get; set; } = [];

    [Parameter] public int Limit { get; set; } = 50;
}
