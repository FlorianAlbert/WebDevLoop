<OverrideFieldFrame Field="@Field" Label="@Label" IsOverridden="@(!string.IsNullOrWhiteSpace(Value))" Inherited="@Inherited"
                    Errors="@Errors" OnReset="@Reset">
    @if (Multiline)
    {
        <textarea id="@OverrideFieldFrame.InputIdFor(Field)" class="form-control @OverrideFieldFrame.InvalidClass(Errors)" rows="@Rows" value="@Value" placeholder="@Inherited"
                  aria-invalid="@OverrideFieldFrame.InvalidFlag(Errors)" aria-describedby="@OverrideFieldFrame.DescribedBy(Field, Errors)" @onchange="Changed"></textarea>
    }
    else
    {
        <input id="@OverrideFieldFrame.InputIdFor(Field)" type="text" class="form-control @OverrideFieldFrame.InvalidClass(Errors)" value="@Value" placeholder="@Inherited"
               aria-invalid="@OverrideFieldFrame.InvalidFlag(Errors)" aria-describedby="@OverrideFieldFrame.DescribedBy(Field, Errors)" @onchange="Changed" />
    }
</OverrideFieldFrame>

@code {
    [Parameter, EditorRequired] public string Field { get; set; } = string.Empty;

    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;

    [Parameter] public string? Value { get; set; }

    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    /// <summary>The value in effect when this field is empty; shown as the placeholder.</summary>
    [Parameter] public string? Inherited { get; set; }

    [Parameter] public IReadOnlyList<string> Errors { get; set; } = [];

    [Parameter] public bool Multiline { get; set; }

    [Parameter] public int Rows { get; set; } = 3;

    private Task Changed(ChangeEventArgs args) => ValueChanged.InvokeAsync(args.Value?.ToString());

    private Task Reset() => ValueChanged.InvokeAsync(null);
}
