@implements IDisposable
@using WebDevLoop.Core.Agents
@using WebDevLoop.Web.Api
@using WebDevLoop.Core.Queries
@inject IAgentLogReader Logs
@inject IAgentLogNotifications LogNotifications

<SectionCard Title="Agent log" data-testid="log-tail">
    @if (_hidden > 0)
    {
        <p class="small text-body-secondary" data-testid="log-hidden">@_hidden earlier entries not shown.</p>
    }
    @if (_entries.Count == 0)
    {
        <p class="quiet-note" data-testid="log-empty">No agent output yet.</p>
    }
    else
    {
        <div class="border rounded p-2 bg-body-tertiary small font-monospace overflow-auto" style="max-height: 30rem">
            @foreach (AgentLogView entry in _entries)
            {
                <div data-testid="log-entry" data-kind="@entry.Kind" class="@(KindClass(entry.Kind))">
                    <span class="text-body-secondary">@entry.At.ToString("HH:mm:ss")</span>
                    <span class="badge bg-body-secondary text-body border">@DisplayNames.Humanize(entry.Kind.ToString())</span>
                    <span style="white-space: pre-wrap">@entry.Text</span>
                </div>
            }
        </div>
    }
</SectionCard>

@code {
    private readonly List<AgentLogView> _entries = [];
    private readonly SemaphoreSlim _readGate = new(1, 1);
    private readonly CancellationTokenSource _disposed = new();
    private IDisposable? _subscription;
    private int _refreshRequested;
    private int _lastSequence;
    private int _hidden;
    private bool _wasFollowing;

    /// <summary>Only a safety net: new entries normally arrive by push (<see cref="IAgentLogNotifications"/>).</summary>
    public static readonly TimeSpan DefaultPollInterval = TimeSpan.FromSeconds(15);

    [Parameter, EditorRequired] public string StepRunId { get; set; } = string.Empty;

    /// <summary>True while the step runs: new entries are tailed on push and by the fallback poll. Turning false triggers one last read.</summary>
    [Parameter] public bool Follow { get; set; }

    /// <summary>Interval of the fallback poll that runs next to the push notifications; zero disables it.</summary>
    [Parameter] public TimeSpan PollInterval { get; set; } = DefaultPollInterval;

    [Parameter] public int MaxEntries { get; set; } = 500;

    protected override async Task OnInitializedAsync()
    {
        if (ApiIds.Step(StepRunId) is { } stepId)
        {
            _subscription = LogNotifications.Subscribe(stepId, OnEntriesAvailable);
        }

        await ReadNewAsync();
    }

    // Requests are coalesced; the flag is cleared before reading so an entry flushed during the read triggers another one.
    private void OnEntriesAvailable()
    {
        if (!Follow || Interlocked.Exchange(ref _refreshRequested, 1) == 1)
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            Interlocked.Exchange(ref _refreshRequested, 0);
            try
            {
                if (Follow && await ReadNewAsync())
                {
                    StateHasChanged();
                }
            }
            catch (OperationCanceledException) when (_disposed.IsCancellationRequested)
            {
                // The tail was closed while reading.
            }
        });
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_wasFollowing && !Follow)
        {
            await ReadNewAsync();
        }

        _wasFollowing = Follow;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && PollInterval > TimeSpan.Zero)
        {
            _ = PollAsync(PollInterval);
        }
    }

    private async Task PollAsync(TimeSpan interval)
    {
        using var timer = new PeriodicTimer(interval);
        try
        {
            while (await timer.WaitForNextTickAsync(_disposed.Token))
            {
                if (Follow)
                {
                    await InvokeAsync(async () =>
                    {
                        if (await ReadNewAsync())
                        {
                            StateHasChanged();
                        }
                    });
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task<bool> ReadNewAsync()
    {
        if (ApiIds.Step(StepRunId) is not { } stepId)
        {
            return false;
        }

        await _readGate.WaitAsync(_disposed.Token);
        try
        {
            IReadOnlyList<AgentLogView> fresh = await Logs.ReadAsync(stepId, _lastSequence, _disposed.Token);
            if (fresh.Count == 0)
            {
                return false;
            }

            _entries.AddRange(fresh);
            _lastSequence = fresh[^1].Sequence;
            int overflow = Math.Max(0, _entries.Count - MaxEntries);
            _entries.RemoveRange(0, overflow);
            _hidden += overflow;
            return true;
        }
        finally
        {
            _readGate.Release();
        }
    }

    private static string KindClass(AgentLogKind kind) => kind switch
    {
        AgentLogKind.Error or AgentLogKind.PermissionDenied => "text-danger",
        AgentLogKind.Reasoning => "text-body-secondary fst-italic",
        _ => string.Empty,
    };

    public void Dispose()
    {
        _subscription?.Dispose();
        _disposed.Cancel();
    }
}
