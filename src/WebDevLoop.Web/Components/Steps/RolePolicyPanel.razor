@using WebDevLoop.Web.Components.Runs
<SectionCard Title="@($"Role policy: {DisplayNames.For(Policy.Role)}")" data-testid="role-policy">
    <dl class="fact-list">
        <dt class="fact-list__label">Allowed capabilities</dt>
        <dd class="fact-list__value" data-testid="policy-capabilities">
            <ul class="chip-list">
                @foreach (var capability in Policy.AllowedCapabilities)
                {
                    <li><StatusPill>@RunDisplay.Capability(capability)</StatusPill></li>
                }
            </ul>
        </dd>
        <dt class="fact-list__label">Denied commands</dt>
        <dd class="fact-list__value" data-testid="policy-denied">
            @if (Policy.DeniedCommands.Count == 0)
            {
                <span class="text-body-secondary">None</span>
            }
            else
            {
                <ul class="chip-list">
                    @foreach (string command in Policy.DeniedCommands)
                    {
                        <li><code class="chip">@command</code></li>
                    }
                </ul>
            }
        </dd>
        <dt class="fact-list__label">GitHub token</dt>
        <dd class="fact-list__value" data-testid="policy-token">@RunDisplay.TokenAccess(Policy.TokenAccess)</dd>
        <dt class="fact-list__label">Report tool</dt>
        <dd class="fact-list__value"><code>@Policy.ReportTool</code></dd>
    </dl>
</SectionCard>

@code {
    [Parameter, EditorRequired] public RolePolicySummary Policy { get; set; } = default!;
}
