@using WebDevLoop.Core.Queries

<SectionCard Title="Pull request stack" data-testid="stack-layers">
    @if (Layers.Count == 0)
    {
        <p class="quiet-note">No stack layers yet.</p>
    }
    else
    {
        <div class="table-responsive">
        <table class="table table-sm align-middle mb-0 detail-table">
            <thead><tr><th>#</th><th>Pull request</th><th>Branch</th><th>Base</th><th>Commit</th><th>Draft</th></tr></thead>
            <tbody>
                @foreach (StackLayerView layer in Layers.OrderBy(layer => layer.Position))
                {
                    <tr data-testid="stack-layer-@layer.Position">
                        <td>@layer.Position</td>
                        <td>#@layer.PullRequestNumber@(layer.StackNumber is { } stack ? $" (stack {stack})" : "")</td>
                        <td><code>@layer.BranchName</code></td>
                        <td><code>@layer.BaseBranch</code></td>
                        <td><ShortHash Value="@layer.CommitSha" /></td>
                        <td>@(layer.IsDraft ? "draft" : "ready")</td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }
</SectionCard>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<StackLayerView> Layers { get; set; } = [];

}
