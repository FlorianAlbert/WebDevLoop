@page "/settings"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Routing
@using WebDevLoop.Core.Queries
@using WebDevLoop.Web.Components.Repositories
@using WebDevLoop.Web.Components.Shared
@inject IRepositoryQueries Repositories
@inject RepositoryContext RepositoryContext
@inject NavigationManager Navigation
@inject IJSRuntime Js

<PageHeader Title="Settings" Description="Defaults for all repositories, with optional per-repository overrides." />

<NavigationLock OnBeforeInternalNavigation="ConfirmLeaveAsync" ConfirmExternalNavigation="_dirty" />

<div class="mb-3">
    <label class="form-label fw-semibold" for="settings-scope">Edit settings for</label>
    <select id="settings-scope" class="form-select w-auto mw-100" data-testid="scope" @key="_scopeKey" @onchange="ScopeChanged">
        <option value="@GlobalScope" selected="@(_repositoryId is null)">Global (all repositories)</option>
        @foreach (RepositoryView repository in _repositories)
        {
            <option value="@repository.Id" selected="@(repository.Id == _repositoryId)">@repository.Owner/@repository.Name</option>
        }
    </select>
    <div class="form-text">Repository settings only override what you fill in; everything else is inherited from the global settings.</div>
</div>

<h2 class="h5" data-testid="scope-title">@ScopeTitle</h2>

<SettingsEditor RepositoryId="_repositoryId" DirtyChanged="DirtyChanged" />

@code {
    private const string GlobalScope = "global";

    private IReadOnlyList<RepositoryView> _repositories = [];
    private int? _repositoryId;
    private bool _dirty;
    private int _scopeKey;

    /// <summary>"global" or a repository id; without it the page follows the repository selected in the top bar.</summary>
    [SupplyParameterFromQuery(Name = "repo")]
    public string? Repo { get; set; }

    private string ScopeTitle => _repositories.FirstOrDefault(repository => repository.Id == _repositoryId) is { } repository
        ? $"Overrides for {repository.Owner}/{repository.Name}"
        : "Global settings";

    protected override async Task OnInitializedAsync() => _repositories = await Repositories.ListAsync(CancellationToken.None);

    protected override void OnParametersSet() =>
        _repositoryId = Repo is null
            ? RepositoryContext.CurrentRepositoryId
            : int.TryParse(Repo, out int id) ? id : null;

    private void ScopeChanged(ChangeEventArgs args)
    {
        string? value = args.Value?.ToString();
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("repo", string.IsNullOrEmpty(value) ? GlobalScope : value));
    }

    private void DirtyChanged(bool dirty) => _dirty = dirty;

    private async Task ConfirmLeaveAsync(LocationChangingContext context)
    {
        if (!_dirty)
        {
            return;
        }

        bool leave;
        try
        {
            leave = await Js.InvokeAsync<bool>("confirm", "You have unsaved settings. Leave this page and discard them?");
        }
        catch (JSDisconnectedException)
        {
            return;
        }

        if (!leave)
        {
            context.PreventNavigation();
            _scopeKey++;
        }
    }
}
