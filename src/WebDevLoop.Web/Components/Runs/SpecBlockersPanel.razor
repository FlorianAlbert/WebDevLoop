@using WebDevLoop.Core.Queries
@using WebDevLoop.Web.Components.Layout
@using WebDevLoop.Web.Components.Queue

<SectionCard Title="Native parent blockers" data-testid="spec-blockers">
    @if (Blockers.UnavailableReason is { } error)
    {
        <p class="text-warning" role="status">@error</p>
    }
    else if (!Blockers.Evaluated)
    {
        <p class="quiet-note">Current blockers are not checked for finished runs.</p>
    }
    else if (Blockers.Blockers.Count == 0)
    {
        <p class="quiet-note">No native parent blockers.</p>
    }
    else
    {
        <ul class="list-unstyled mb-0">
            @foreach (ParentBlockerView blocker in Blockers.Blockers)
            {
                string key = blocker.BlockingSpecRunId ?? $"issue-{blocker.IssueNumber}";
                <li class="@(blocker.IsSatisfied ? "text-success" : "")" data-testid="spec-blocker-@key">
                    @if (blocker.BlockingSpecRunId is { } runId)
                    {
                        <a href="@UiRoutes.Run(runId)" data-testid="spec-blocker-link-@key">@blocker.Issue @blocker.Title</a>
                        <span>(@SpecRunDisplay.Label(blocker.Status!.Value))</span>
                    }
                    else
                    {
                        <span>@blocker.Issue @blocker.Title</span>
                        <span class="text-body-secondary">(not tracked by this app)</span>
                    }
                    <span class="small">— @(blocker.IsSatisfied ? "closed" : "open; waiting")</span>
                </li>
            }
        </ul>
    }
</SectionCard>

@code {
    [Parameter, EditorRequired] public ParentBlockersView Blockers { get; set; } = ParentBlockersView.NotEvaluated;
}
