@using WebDevLoop.Core.Orchestration.SpecQueue
@using WebDevLoop.Infrastructure.Prerequisites
@inherits ScopedComponentBase
@inject DiagnosticReadiness Readiness

<form class="row g-2 align-items-start" @onsubmit="SubmitAsync" novalidate>
    <div class="col-auto">
        <label class="col-form-label col-form-label-sm" for="enqueue-issue">Queue parent spec issue</label>
    </div>
    <div class="col-auto">
        <input id="enqueue-issue" name="issueNumber" type="text" inputmode="numeric" autocomplete="off"
               class="form-control form-control-sm @(_validation is null ? null : "is-invalid")" placeholder="#123 or issue URL"
               aria-describedby="enqueue-help@(_validation is null ? null : " enqueue-error")" aria-invalid="@(_validation is null ? null : "true")"
               @bind="_issueNumber" @bind:event="oninput" disabled="@IsDisabled" />
        @if (_validation is not null)
        {
            <div id="enqueue-error" class="invalid-feedback d-block" data-testid="enqueue-validation">@_validation</div>
        }
        <div id="enqueue-help" class="form-text">Issue number, <code>#123</code> or a GitHub issue URL.</div>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary btn-sm" data-testid="enqueue-submit" disabled="@(IsDisabled || _submitting)" aria-busy="@(_submitting ? "true" : null)">
            @if (_submitting)
            {
                <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
            }
            @(_submitting ? "Queueing…" : "Queue")
        </button>
    </div>
    @if (IsDisabled)
    {
        <div class="col-auto small text-warning-emphasis" data-testid="enqueue-disabled">
            Workflow actions are disabled while the app is in diagnostic-only mode. <a href="@UiRoutes.Health">See health</a>.
        </div>
    }
</form>

@if (_result is { } result)
{
    <div class="alert alert-@result.Severity py-1 px-2 small mt-2 mb-0" role="status" data-testid="enqueue-result">
        @result.Message
        @if (result.RunId is { } runId)
        {
            <a href="@UiRoutes.Run(runId)">Open run @runId</a>
        }
    </div>
}

@code {
    private sealed record Feedback(string Severity, string Message, string? RunId = null);

    private string? _issueNumber;
    private string? _validation;
    private bool _submitting;
    private Feedback? _result;

    [Parameter, EditorRequired]
    public int RepositoryId { get; set; }

    [Parameter]
    public EventCallback OnQueued { get; set; }

    private bool IsDisabled => Readiness.Current.Mode != ReadinessMode.Operational;

    private async Task SubmitAsync()
    {
        if (IsDisabled)
        {
            return;
        }

        if (!TryParseIssue(_issueNumber, out int issueNumber))
        {
            _validation = "Enter a positive issue number, for example 123, #123 or a GitHub issue URL.";
            _result = null;
            return;
        }

        _validation = null;
        _submitting = true;
        try
        {
            EnqueueResult result = await InScopeAsync(services =>
                services.GetRequiredService<ISpecEnqueuer>().EnqueueAsync(RepositoryId, issueNumber, CancellationToken.None));
            _result = Describe(issueNumber, result);
            if (result.Outcome == EnqueueOutcome.Queued)
            {
                _issueNumber = null;
                await OnQueued.InvokeAsync();
            }
        }
        catch (Exception exception)
        {
            _result = new Feedback("danger", $"Could not queue #{issueNumber}: {exception.Message}");
        }
        finally
        {
            _submitting = false;
        }
    }

    /// <summary>Accepts "123", "#123" and issue URLs such as https://github.com/owner/repo/issues/123.</summary>
    internal static bool TryParseIssue(string? input, out int issueNumber)
    {
        issueNumber = 0;
        string text = (input ?? string.Empty).Trim();
        if (text.Length == 0)
        {
            return false;
        }

        if (Uri.TryCreate(text, UriKind.Absolute, out Uri? uri) && uri.Scheme is "http" or "https")
        {
            string[] segments = uri.AbsolutePath.Split('/', StringSplitOptions.RemoveEmptyEntries);
            int index = Array.FindIndex(segments, segment => segment.Equals("issues", StringComparison.OrdinalIgnoreCase));
            text = index >= 0 && index + 1 < segments.Length ? segments[index + 1] : string.Empty;
        }
        else
        {
            text = text.TrimStart('#');
        }

        return int.TryParse(text, System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out issueNumber) && issueNumber > 0;
    }

    private static Feedback Describe(int issueNumber, EnqueueResult result) => result.Outcome switch
    {
        EnqueueOutcome.Queued => new("success", $"Queued #{issueNumber}.", result.SpecRunId?.Value),
        EnqueueOutcome.AlreadyQueued => new("info", $"#{issueNumber} is already queued.", result.SpecRunId?.Value),
        EnqueueOutcome.RepositoryNotFound => new("danger", "This repository no longer exists."),
        _ => new("warning", $"The queue changed at the same time; please try again."),
    };
}
