@page "/steps/{Id}"
@inherits LiveDetailPageBase
@using WebDevLoop.Core.Domain
@using WebDevLoop.Core.Queries
@using WebDevLoop.Web.Api
@using WebDevLoop.Web.Components.Runs
@using WebDevLoop.Web.Components.Layout

<PageHeader Title="@(_step is null ? (IsNotFound ? "Step not found" : "Step") : $"{DisplayNames.Humanize(_step.Kind.ToString())} step")" />

@if (IsNotFound)
{
    <EmptyState Icon="search" Title="Nothing to show here" data-testid="not-found">
        <ChildContent>Step '@Id' does not exist or was removed.</ChildContent>
        <Action><a class="btn btn-primary btn-sm" href="@UiRoutes.Queue">Back to queue</a></Action>
    </EmptyState>
}
else if (_step is not null)
{
    <div class="detail-summary">
        <StatusBadge Status="@_step.Status.ToString()" data-testid="step-status" />
        <a href="/runs/@_step.SpecRunId" data-testid="spec-link">Spec run @_step.SpecRunId</a>
        @if (_step.TicketRunId is { } ticketId)
        {
            <a href="/tickets/@ticketId" data-testid="ticket-link">Ticket run @ticketId</a>
        }
    </div>
    @if (_step.FailureReason is { } failure)
    {
        <p class="alert alert-danger" data-testid="failure-reason">@failure</p>
    }

    <SectionCard Title="Details" data-testid="step-details">
        <dl class="fact-list">
            <dt class="fact-list__label">Role</dt>
            <dd class="fact-list__value" data-testid="step-role">@(_step.AgentRole is { } agentRole ? DisplayNames.For(agentRole) : "None (app-run step)")</dd>
            <dt class="fact-list__label">Model</dt>
            <dd class="fact-list__value" data-testid="step-model">@StepModelText.For(_step)</dd>
            <dt class="fact-list__label">Attempt</dt>
            <dd class="fact-list__value">@_step.Attempt</dd>
            <dt class="fact-list__label">Copilot session</dt>
            <dd class="fact-list__value" data-testid="copilot-session"><ShortHash Value="@_step.CopilotSessionId" /></dd>
            <dt class="fact-list__label">Branch</dt>
            <dd class="fact-list__value" data-testid="step-branch">@if (_step.BranchName is { } branch) { <code>@branch</code> } else { <span class="text-body-secondary">–</span> }</dd>
            <dt class="fact-list__label">Worktree</dt>
            <dd class="fact-list__value" data-testid="step-worktree">@if (_step.WorktreePath is { } worktree) { <code>@worktree</code> } else { <span class="text-body-secondary">–</span> }</dd>
            <dt class="fact-list__label">Prompt hash</dt>
            <dd class="fact-list__value" data-testid="step-prompt-hash"><ShortHash Value="@_step.InputPromptHash" /></dd>
            <dt class="fact-list__label">Started</dt>
            <dd class="fact-list__value" data-testid="step-started"><AppDateTime Value="_step.StartedAt" /></dd>
            <dt class="fact-list__label">Completed</dt>
            <dd class="fact-list__value" data-testid="step-completed"><AppDateTime Value="_step.CompletedAt" /></dd>
            <dt class="fact-list__label">Timeout</dt>
            <dd class="fact-list__value" data-testid="step-timeout">
                @if (RunDisplay.Timeout(_step.StartedAt, _step.TimeoutAt) is { } timeout) { <span>@timeout</span> } else { <span class="text-body-secondary">–</span> }
            </dd>
        </dl>
    </SectionCard>

    <RunControlsArea Scope="step" />

    @if (_policy is not null)
    {
        <RolePolicyPanel Policy="_policy" />
    }

    <StructuredReportPanel ResultJson="@_step.StructuredResultJson" />
    <AgentLogTail StepRunId="@_step.Id" Follow="@(_step.Status is StepStatus.Pending or StepStatus.Running)" PollInterval="LogPollInterval" />
}

@code {
    private StepRunView? _step;
    private RolePolicySummary? _policy;

    [Parameter] public string Id { get; set; } = string.Empty;

    /// <summary>Interval of the log tail's fallback poll while the step is active; zero disables it. New entries arrive by push.</summary>
    [Parameter] public TimeSpan LogPollInterval { get; set; } = AgentLogTail.DefaultPollInterval;

    protected override bool IsRelevant(LiveEventView view) => RunEventSubscription.Concerns(view, _step?.SpecRunId);

    protected override async Task LoadAsync(CancellationToken cancellationToken)
    {
        var queries = ScopedServices.GetRequiredService<IRunQueries>();
        if (ApiIds.Step(Id) is not { } stepId || await queries.GetStepAsync(stepId, cancellationToken) is not { } step)
        {
            IsNotFound = true;
            _step = null;
            return;
        }

        IsNotFound = false;
        _step = step;
        _policy = step.AgentRole is { } role ? RolePolicySummary.For(role) : null;
    }
}
