@page "/tickets/{Id}"
@inherits LiveDetailPageBase
@using WebDevLoop.Core.Domain
@using WebDevLoop.Core.Queries
@using WebDevLoop.Web.Api
@using WebDevLoop.Web.Components.Runs
@using WebDevLoop.Web.Components.Layout
@using WebDevLoop.Web.Components.Steps

<PageHeader Title="@(_ticket is null ? (IsNotFound ? "Ticket run not found" : "Ticket run") : $"#{_ticket.IssueNumber} {_ticket.Title}")" DocumentTitle="@(_ticket?.Title ?? "Ticket run")" />

@if (IsNotFound)
{
    <EmptyState Icon="search" Title="Nothing to show here" data-testid="not-found">
        <ChildContent>Ticket run '@Id' does not exist or was removed.</ChildContent>
        <Action><a class="btn btn-primary btn-sm" href="@UiRoutes.Queue">Back to queue</a></Action>
    </EmptyState>
}
else if (_ticket is not null)
{
    <div class="detail-summary">
        <StatusBadge Status="@_ticket.Status.ToString()" data-testid="ticket-status" />
        <a href="/runs/@_ticket.SpecRunId" data-testid="spec-link">Spec run @_ticket.SpecRunId</a>
        @if (_ticket.PullRequestNumber is { } pr)
        {
            <span data-testid="ticket-pr">PR #@pr@(_ticket.StackPosition is { } position ? $" (stack layer {position})" : "")</span>
        }
    </div>
    @if (_ticket.Status == TicketRunStatus.NeedsAttention)
    {
        AttentionReason attention = AttentionDisplay.Resolve(_ticket.Attention, _ticket.FailureReason, forTicket: true);
        <AttentionCard Reason="attention" TroubleshooterActive="@_steps.Any(step => step is { Kind: StepKind.Troubleshoot } && step.Status.IsActive())">
            <TicketRunControls Ticket="_ticket" Siblings="_siblings" Attention="attention" OnChanged="RefreshAsync" />
        </AttentionCard>
    }
    else if (_ticket.FailureReason is { } failure)
    {
        <p class="alert alert-danger" data-testid="failure-reason">@failure</p>
    }

    <SectionCard Title="Details" data-testid="ticket-details">
        <dl class="fact-list">
            <dt class="fact-list__label">Branch</dt>
            <dd class="fact-list__value" data-testid="ticket-branch"><code>@_ticket.BranchName</code></dd>
            <dt class="fact-list__label">Worktree</dt>
            <dd class="fact-list__value" data-testid="ticket-worktree">
                @if (_ticket.WorktreePath is { } worktree) { <code>@worktree</code> } else { <span class="text-body-secondary">Not created</span> }
            </dd>
            <dt class="fact-list__label">Attempt</dt>
            <dd class="fact-list__value">@_ticket.Attempt</dd>
            <dt class="fact-list__label">Review iteration</dt>
            <dd class="fact-list__value" data-testid="review-iteration">@_ticket.ReviewIteration</dd>
            <dt class="fact-list__label">Last implemented</dt>
            <dd class="fact-list__value"><ShortHash Value="@_ticket.LastImplementedSha" /></dd>
            <dt class="fact-list__label">Integrated commit</dt>
            <dd class="fact-list__value"><ShortHash Value="@_ticket.IntegratedCommitSha" /></dd>
            <dt class="fact-list__label">Blocked by</dt>
            <dd class="fact-list__value" data-testid="ticket-blockers">
                @if (_blockers.Count == 0)
                {
                    <span class="text-body-secondary">Nothing</span>
                }
                @foreach (TicketBlocker blocker in _blockers)
                {
                    <span class="me-3 d-inline-block @(blocker.IsSatisfied ? "text-success" : "")">
                        <a href="/tickets/@blocker.TicketRunId">@(blocker.Issue is { } issue ? $"#{issue}" : blocker.TicketRunId)</a> (@(blocker.Status is { } status ? DisplayNames.Humanize(status.ToString()) : "unknown"))
                    </span>
                }
            </dd>
        </dl>
    </SectionCard>

    @if (_ticket.Status != TicketRunStatus.NeedsAttention)
    {
        <RunControlsArea Scope="ticket run">
            <TicketRunControls Ticket="_ticket" Siblings="_siblings" OnChanged="RefreshAsync" />
        </RunControlsArea>
    }

    <StepsTable Steps="_steps" />
    <TicketFindingsPanel Steps="_steps" />
    <SagaCheckpointTimeline Saga="_saga" />
}

@code {
    private TicketRunView? _ticket;
    private IReadOnlyList<TicketBlocker> _blockers = [];
    private IReadOnlyList<TicketRunView> _siblings = [];
    private IReadOnlyList<StepRunView> _steps = [];
    private IntegrationSagaView? _saga;

    [Parameter] public string Id { get; set; } = string.Empty;

    protected override bool IsRelevant(LiveEventView view) => RunEventSubscription.Concerns(view, _ticket?.SpecRunId);

    protected override async Task LoadAsync(CancellationToken cancellationToken)
    {
        var queries = ScopedServices.GetRequiredService<IRunQueries>();
        if (ApiIds.TicketRun(Id) is not { } ticketId || await queries.GetTicketRunAsync(ticketId, cancellationToken) is not { } ticket)
        {
            IsNotFound = true;
            _ticket = null;
            return;
        }

        IsNotFound = false;
        _ticket = ticket;
        _siblings = await queries.ListTicketRunsAsync(new RunId(ticket.SpecRunId), cancellationToken);
        _blockers = TicketDagLayout.Build(_siblings).FirstOrDefault(row => row.Ticket.Id == ticket.Id)?.Blockers ?? [];
        _steps = await queries.ListStepsAsync(ticketId, cancellationToken);
        _saga = await queries.GetLatestSagaAsync(ticketId, cancellationToken);
    }
}
