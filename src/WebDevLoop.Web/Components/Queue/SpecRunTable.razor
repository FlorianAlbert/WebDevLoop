@if (Runs.Count > 0)
{
    <div class="table-responsive">
    <table class="table table-sm table-hover align-middle mb-0">
        <tbody>
            @foreach (SpecRunView run in Runs)
            {
                <tr data-run-id="@run.Id">
                    <td class="text-body-secondary text-nowrap">#@run.ParentIssueNumber</td>
                    <td>@run.Title</td>
                    <td class="@(run.Status == SpecRunStatus.NeedsAttention ? "" : "text-nowrap")">
                        <SpecStatusBadge Status="run.Status" />
                        @if (run.Status == SpecRunStatus.NeedsAttention)
                        {
                            <div class="small mt-1 queue-attention" data-testid="run-attention-@run.Id">@SpecRunDisplay.Note(run)</div>
                        }
                    </td>
                    <td class="small text-body-secondary" data-testid="run-note-@run.Id">
                        @if (run.Status == SpecRunStatus.NeedsAttention)
                        {
                            <a href="@UiRoutes.Run(run.Id)">@AttentionDisplay.CallToAction(run.Attention)</a>
                        }
                        else
                        {
                            @if (Blockers.GetValueOrDefault(run.Id)?.UnavailableReason is { } error)
                            {
                                <span class="text-warning" role="status">@error</span>
                            }
                            else
                            {
                                @SpecRunDisplay.Note(run, Blockers.GetValueOrDefault(run.Id)?.Blockers)
                            }
                        }
                    </td>
                    <td class="text-end"><a href="@UiRoutes.Run(run.Id)">Details</a></td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<SpecRunView> Runs { get; set; } = [];

    /// <summary>Current native parent blockers per spec run id, for the waiting note.</summary>
    [Parameter]
    public IReadOnlyDictionary<string, ParentBlockersView> Blockers { get; set; } = new Dictionary<string, ParentBlockersView>();

}
