@page "/steps/{Id}"
@inherits LiveDetailPageBase
@using WebDevLoop.Core.Domain
@using WebDevLoop.Core.Queries
@using WebDevLoop.Web.Api
@using WebDevLoop.Web.Components.Runs
@using WebDevLoop.Web.Components.Layout

<PageHeader Title="@(_step is null ? (IsNotFound ? "Step not found" : "Step") : $"{_step.Kind} step")" />

@if (IsNotFound)
{
    <EmptyState Icon="search" Title="Step not found" data-testid="not-found">
        <ChildContent>Step '@Id' does not exist or was removed.</ChildContent>
        <Action><a class="btn btn-primary btn-sm" href="@UiRoutes.Queue">Back to queue</a></Action>
    </EmptyState>
}
else if (_step is not null)
{
    <p>
        <StatusBadge Status="@_step.Status.ToString()" data-testid="step-status" />
        <a class="ms-2" href="/runs/@_step.SpecRunId" data-testid="spec-link">Spec run @_step.SpecRunId</a>
        @if (_step.TicketRunId is { } ticketId)
        {
            <a class="ms-2" href="/tickets/@ticketId" data-testid="ticket-link">Ticket run @ticketId</a>
        }
    </p>
    @if (_step.FailureReason is { } failure)
    {
        <p class="alert alert-danger" data-testid="failure-reason">@failure</p>
    }

    <dl class="row">
        <dt class="col-sm-3">Role</dt>
        <dd class="col-sm-9" data-testid="step-role">@(_step.AgentRole is { } agentRole ? DisplayNames.For(agentRole) : "none (app-run step)")</dd>
        <dt class="col-sm-3">Model</dt>
        <dd class="col-sm-9" data-testid="step-model">@StepModelText.For(_step)</dd>
        <dt class="col-sm-3">Attempt</dt>
        <dd class="col-sm-9">@_step.Attempt</dd>
        <dt class="col-sm-3">Copilot session</dt>
        <dd class="col-sm-9" data-testid="copilot-session"><code>@(_step.CopilotSessionId ?? "–")</code></dd>
        <dt class="col-sm-3">Branch / worktree</dt>
        <dd class="col-sm-9"><code>@(_step.BranchName ?? "–")</code> <code>@(_step.WorktreePath ?? "")</code></dd>
        <dt class="col-sm-3">Prompt hash</dt>
        <dd class="col-sm-9"><code>@_step.InputPromptHash</code></dd>
        <dt class="col-sm-3">Started / completed / timeout</dt>
        <dd class="col-sm-9"><AppDateTime Value="_step.StartedAt" /> / <AppDateTime Value="_step.CompletedAt" /> / <AppDateTime Value="_step.TimeoutAt" /></dd>
    </dl>

    <RunControlsArea Scope="step" />

    @if (_policy is not null)
    {
        <RolePolicyPanel Policy="_policy" />
    }

    <StructuredReportPanel ResultJson="@_step.StructuredResultJson" />
    <AgentLogTail StepRunId="@_step.Id" Follow="@(_step.Status is StepStatus.Pending or StepStatus.Running)" PollInterval="LogPollInterval" />
}

@code {
    private StepRunView? _step;
    private RolePolicySummary? _policy;

    [Parameter] public string Id { get; set; } = string.Empty;

    /// <summary>Interval of the log tail's fallback poll while the step is active; zero disables it. New entries arrive by push.</summary>
    [Parameter] public TimeSpan LogPollInterval { get; set; } = AgentLogTail.DefaultPollInterval;

    protected override bool IsRelevant(LiveEventView view) => RunEventSubscription.Concerns(view, _step?.SpecRunId);

    protected override async Task LoadAsync(CancellationToken cancellationToken)
    {
        var queries = ScopedServices.GetRequiredService<IRunQueries>();
        if (ApiIds.Step(Id) is not { } stepId || await queries.GetStepAsync(stepId, cancellationToken) is not { } step)
        {
            IsNotFound = true;
            _step = null;
            return;
        }

        IsNotFound = false;
        _step = step;
        _policy = step.AgentRole is { } role ? RolePolicySummary.For(role) : null;
    }
}
