@page "/Error"
@attribute [ExcludeFromInteractiveRouting]
@using System.Diagnostics

<PageHeader Title="Something went wrong" DocumentTitle="Error" />

<EmptyState Icon="alert" Title="We couldn't complete your request" Text="An unexpected error occurred. Try again, or go back to the dashboard.">
    <Action>
        <a class="btn btn-primary btn-sm" href="@UiRoutes.Dashboard">Go to dashboard</a>
        <a class="btn btn-outline-secondary btn-sm ms-2" href="@UiRoutes.Queue">Back to queue</a>
    </Action>
</EmptyState>

@if (ShowRequestId)
{
    <details class="mt-3 small" data-testid="error-details">
        <summary>Technical details</summary>
        <p class="mt-2 mb-0">Request ID: <code>@RequestId</code></p>
    </details>
}

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [PersistentState]
    public string? RequestId { get; set; }

    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized()
    {
        RequestId ??= Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
    }
}
