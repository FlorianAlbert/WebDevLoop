@using WebDevLoop.Core.Domain
@using WebDevLoop.Core.Queries
@using WebDevLoop.Web.Components.Runs

<RunControlPanel Commands="Commands" OnApplied="OnChanged" />

@code {
    [Parameter, EditorRequired] public TicketRunView Ticket { get; set; } = default!;

    /// <summary>All tickets of the spec, to name the dependents each command affects.</summary>
    [Parameter] public IReadOnlyList<TicketRunView> Siblings { get; set; } = [];

    /// <summary>When set, only the buttons this reason lists are offered, worded as it words them.</summary>
    [Parameter] public AttentionReason? Attention { get; set; }

    [Parameter] public EventCallback OnChanged { get; set; }

    private IReadOnlyList<RunControlCommand> Commands => TicketRunCommands.Build(Ticket, Siblings, Attention);
}
