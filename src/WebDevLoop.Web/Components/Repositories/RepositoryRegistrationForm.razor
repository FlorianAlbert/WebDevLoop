@inherits ScopedComponentBase
@using WebDevLoop.Infrastructure.GitHub.Auth
@using WebDevLoop.Infrastructure.GitHub.Pulls
@inject GitHubUserSession Session
@inject GitHubAppAccess AppAccess

<div class="card card-body mb-3" data-testid="register-form">
    @if (!Session.Status.IsConfigured || !Session.Status.IsSignedIn)
    {
        <div class="alert alert-warning mb-2" role="alert" data-testid="register-signin-required">
            @(Session.Status.IsConfigured ? "Sign in with GitHub" : "Configure the GitHub sign-in") on the
            <a href="github">GitHub page</a> first: repositories are activated from the ones the GitHub App can reach.
        </div>
    }
    else
    {
        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
            <input type="search" name="filter" class="form-control form-control-sm w-auto flex-grow-1" placeholder="Filter repositories…" aria-label="Filter repositories"
                   data-testid="register-filter" @bind="Filter" @bind:event="oninput" />
            <button type="button" class="btn btn-outline-secondary btn-sm" data-testid="register-refresh" disabled="@(_loading || _busy)" @onclick="LoadAsync">
                @(_loading ? "Loading…" : "Refresh")
            </button>
        </div>

        @if (_error is not null)
        {
            <div class="alert alert-danger py-1 px-2 small mb-2" role="alert" data-testid="register-errors">@_error</div>
        }

        @if (_accessError is not null)
        {
            <div class="alert alert-danger py-1 px-2 small mb-2" role="alert" data-testid="register-access-error">Could not load the repository access: @_accessError</div>
        }
        else if (_candidates is null)
        {
            <div class="spinner-border spinner-border-sm" role="status"><span class="visually-hidden">Loading…</span></div>
        }
        else if (_candidates.Count == 0)
        {
            <p class="text-muted small mb-0" data-testid="register-none">
                The GitHub App reaches no repository yet. Add repositories to its installation on the <a href="github">GitHub page</a>.
            </p>
        }
        else
        {
            IReadOnlyList<string> visible = VisibleCandidates();
            if (visible.Count == 0)
            {
                <p class="text-muted small mb-0" data-testid="register-no-match">No repository matches “@Filter”.</p>
            }
            else
            {
                <ul class="list-group list-group-flush small" data-testid="register-candidates">
                    @foreach (string fullName in visible)
                    {
                        RepositoryView? registered = FindRegistered(fullName);
                        <li class="list-group-item d-flex align-items-center gap-2 py-1" data-repo="@fullName" data-active="@((registered is not null).ToString().ToLowerInvariant())">
                            <span class="me-auto">@fullName</span>
                            @if (registered is null)
                            {
                                <button type="button" class="btn btn-primary btn-sm" data-testid="activate" disabled="@_busy" @onclick="() => ActivateAsync(fullName)">Activate</button>
                            }
                            else
                            {
                                <span class="badge text-bg-success">Active</span>
                                @if (_confirmRemove == fullName)
                                {
                                    <button type="button" class="btn btn-danger btn-sm" data-testid="confirm-remove" disabled="@_busy" @onclick="() => RemoveAsync(registered)">Confirm remove</button>
                                    <button type="button" class="btn btn-outline-secondary btn-sm" data-testid="cancel-remove" @onclick="() => _confirmRemove = null">Cancel</button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-outline-danger btn-sm" data-testid="remove" disabled="@_busy" @onclick="() => _confirmRemove = fullName">Remove</button>
                                }
                            }
                        </li>
                    }
                </ul>
            }
        }
    }
    <div class="mt-2">
        <button type="button" class="btn btn-outline-secondary btn-sm" data-testid="register-close" @onclick="OnCancel">Close</button>
    </div>
</div>

@code {
    private IReadOnlyList<string>? _candidates;
    private List<RepositoryView> _registered = [];
    private string? _confirmRemove;
    private string? _error;
    private string? _accessError;
    private bool _loading;
    private bool _busy;

    private string Filter { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<RepositoryView> OnRegistered { get; set; }

    [Parameter]
    public EventCallback<RepositoryView> OnRemoved { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Session.Status is { IsConfigured: true, IsSignedIn: true })
        {
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _accessError = null;
        _error = null;
        try
        {
            IReadOnlyList<GitHubAppInstallation> installations = await AppAccess.ListInstallationsAsync(CancellationToken.None);
            _candidates = installations
                .SelectMany(installation => installation.Repositories)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .Order(StringComparer.OrdinalIgnoreCase)
                .ToArray();
            _registered = [.. await InScopeAsync(services => services.GetRequiredService<IRepositoryQueries>().ListAsync(CancellationToken.None))];
        }
        catch (Exception exception) when (exception is HttpRequestException or GitHubTokenUnavailableException or TaskCanceledException)
        {
            _accessError = exception.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private IReadOnlyList<string> VisibleCandidates() =>
        string.IsNullOrWhiteSpace(Filter)
            ? _candidates!
            : _candidates!.Where(name => name.Contains(Filter.Trim(), StringComparison.OrdinalIgnoreCase)).ToArray();

    private RepositoryView? FindRegistered(string fullName) =>
        _registered.FirstOrDefault(repository => string.Equals($"{repository.Owner}/{repository.Name}", fullName, StringComparison.OrdinalIgnoreCase));

    private async Task ActivateAsync(string fullName)
    {
        int separator = fullName.IndexOf('/');
        var command = new RegisterRepositoryCommand(fullName[..separator], fullName[(separator + 1)..]);
        await RunAsync(async () =>
        {
            CommandResult<RepositoryView> result = await InScopeAsync(services =>
                services.GetRequiredService<IRepositoryRegistry>().RegisterAsync(command, CancellationToken.None));
            if (!result.IsSuccess)
            {
                _error = result.Message;
                return;
            }

            RepositoryView activated = result.Value!;
            _registered.Add(activated);
            await OnRegistered.InvokeAsync(activated);
        });
    }

    private async Task RemoveAsync(RepositoryView repository)
    {
        _confirmRemove = null;
        await RunAsync(async () =>
        {
            CommandResult<int> result = await InScopeAsync(services =>
                services.GetRequiredService<IRepositoryRegistry>().RemoveAsync(repository.Id, CancellationToken.None));
            if (!result.IsSuccess)
            {
                _error = result.Message;
                return;
            }

            _registered.RemoveAll(registered => registered.Id == repository.Id);
            await OnRemoved.InvokeAsync(repository);
        });
    }

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _error = null;
        try
        {
            await action();
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
