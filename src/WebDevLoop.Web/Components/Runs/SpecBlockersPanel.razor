@using WebDevLoop.Core.Queries
@using WebDevLoop.Web.Components.Layout
@using WebDevLoop.Web.Components.Queue

<section class="my-3" data-testid="spec-blockers">
    <h2 class="h5">Blocked by specs</h2>
    @if (Blockers.Count == 0)
    {
        <p class="text-muted">nothing</p>
    }
    else
    {
        <ul class="list-unstyled">
            @foreach (SpecDependencyView blocker in Blockers)
            {
                string key = blocker.BlockingSpecRunId ?? $"issue-{blocker.IssueNumber}";
                <li class="@(blocker.IsSatisfied ? "text-success" : "")" data-testid="spec-blocker-@key">
                    @if (blocker.BlockingSpecRunId is { } runId)
                    {
                        <a href="@UiRoutes.Run(runId)" data-testid="spec-blocker-link-@key">#@blocker.IssueNumber @blocker.Title</a>
                        <span>(@SpecRunDisplay.Label(blocker.Status!.Value))</span>
                    }
                    else
                    {
                        <span>#@blocker.IssueNumber</span>
                        <span class="text-muted">(not tracked by this app)</span>
                    }
                    <span class="small">— @(blocker.IsSatisfied ? "merged" : "waiting")</span>
                </li>
            }
        </ul>
    }
</section>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<SpecDependencyView> Blockers { get; set; } = [];
}
