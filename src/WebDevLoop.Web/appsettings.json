{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // WebDevLoop settings; see README.md ("Configuration"). Override any key with environment variables, e.g.
  // WebDevLoop__GitHub__AppClientId. Never commit secrets (App private key, PAT) to this file.
  "WebDevLoop": {
    // App data root (database, default workspace root, Copilot home). Empty = <LocalApplicationData>/WebDevLoop.
    "DataDirectory": "",
    // SQLite file. Empty = <DataDirectory>/webdevloop.db.
    "DatabasePath": "",
    "GitHub": {
      "ApiBaseUrl": "https://api.github.com/",
      "GraphQlUrl": "https://api.github.com/graphql",
      "AppClientId": "",
      "AppPrivateKeyPath": "",
      "AppPrivateKeyPem": "",
      "UserToken": "",
      "GhStackMode": "RestWithOptionalFallback",
      "GhExecutable": "gh"
    },
    "Copilot": {
      // Empty = the Copilot CLI bundled into the published app.
      "CliPath": "",
      "TokenRefreshSkew": "00:05:00",
      "IdleTimeout": "00:10:00"
    },
    "Tools": {
      "GitExecutable": "git",
      "PlaywrightCliExecutable": "playwright-cli"
    },
    "Workflow": {
      "Enabled": true,
      "ExplorationEnabled": true,
      "OutboxPollInterval": "00:00:01",
      "StartupRetryInterval": "00:00:05",
      "RecoveryInterval": "00:02:00",
      "MergeTrackingInterval": "00:01:00",
      "RuntimeMaintenanceInterval": "00:01:00",
      "OutboxRetention": "7.00:00:00",
      "OutboxPurgeInterval": "06:00:00",
      "StallGracePeriod": "00:05:00",
      "ParkedIntegrationRetryInterval": "00:15:00",
      "TrunkContainmentTimeout": "01:00:00",
      "TesterAppStartupTimeout": "00:10:00"
    },
    "AgentLogs": {
      "MaxEntriesPerStep": 5000,
      "BatchSize": 50,
      "FlushInterval": "00:00:01",
      "PageSize": 1000
    }
  }
}
