<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="LibGit2Sharp" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WebDevLoop.Core\WebDevLoop.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    The Copilot SDK can download its pinned Copilot CLI runtime (~75 MB) at build time. `dotnet publish` bundles it into the
    published app (runtimes/<rid>/native), so a published WebDevLoop ships everything it needs. Development builds stay
    offline and use the Copilot CLI configured in WebDevLoop:Copilot:CliPath (validated at startup). Override either way
    with -p:CopilotSkipCliDownload=true|false.
  -->
  <PropertyGroup>
    <CopilotSkipCliDownload Condition="'$(CopilotSkipCliDownload)' == '' And '$(_IsPublishing)' == 'true'">false</CopilotSkipCliDownload>
    <CopilotSkipCliDownload Condition="'$(CopilotSkipCliDownload)' == ''">true</CopilotSkipCliDownload>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GitHub.Copilot.SDK" />
  </ItemGroup>

  <!-- Bundled agent skills ship with the app output under skills/ (see Skills/Bundled/skills-manifest.json). -->
  <ItemGroup>
    <None Remove="Skills\Bundled\**" />
    <None Include="Skills\Bundled\**\*" Link="skills\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WebDevLoop.Infrastructure.Tests" />
  </ItemGroup>

</Project>
