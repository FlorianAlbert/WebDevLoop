@page "/queue"
@inherits LiveComponentBase

<PageHeader Title="@(_repository is null ? "Queue" : $"Queue · {_repository.Owner}/{_repository.Name}")" DocumentTitle="Queue" />

@if (!IsLoaded)
{
    <div class="placeholder-glow" role="status" aria-busy="true">
        <span class="placeholder col-12 mb-2" style="height: 3rem"></span>
        <span class="placeholder col-12" style="height: 8rem"></span>
        <span class="visually-hidden">Loading…</span>
    </div>
}
else if (LoadError is not null)
{
    <div class="alert alert-danger" role="alert">Could not load the queue: @LoadError</div>
}
else if (_repository is null)
{
    <EmptyState Icon="inbox" Title="No repository selected" Text="Select a repository in the sidebar to see its queue, or register one.">
        <Action><a class="btn btn-primary btn-sm" href="@UiRoutes.Repositories">Add repository</a></Action>
    </EmptyState>
}
else
{
    <div class="d-flex flex-wrap align-items-baseline gap-3 mb-3">
        <span class="small text-body-secondary" data-testid="active-slots">
            Active slots <strong>@ActiveCount@(_settings is null ? "" : $" / {_settings.MaxActiveSpecsPerRepo}")</strong>
        </span>
    </div>

    <div class="mb-3">
        <EnqueueSpecForm RepositoryId="_repository.Id" OnQueued="ReloadAsync" />
    </div>

    @if (_runs.Count == 0)
    {
        <EmptyState Icon="inbox" Title="Nothing queued yet" Text="Queue a parent spec issue above to get started." />
    }

    @foreach (SpecRunLane lane in Enum.GetValues<SpecRunLane>())
    {
        IReadOnlyList<SpecRunView> laneRuns = RunsIn(lane);
        if (laneRuns.Count == 0)
        {
            continue;
        }

        <SectionCard Title="@SpecRunLanes.Title(lane)" Class="mb-3" NoPadding="true" data-lane="@lane">
            <Actions><StatusPill>@laneRuns.Count</StatusPill></Actions>
            <ChildContent><SpecRunTable Runs="laneRuns" Blockers="_blockers" /></ChildContent>
        </SectionCard>
    }
}

@code {
    private RepositoryView? _repository;
    private IReadOnlyList<SpecRunView> _runs = [];
    private EffectiveSettingsView? _settings;
    private IReadOnlyDictionary<string, ParentBlockersView> _blockers = new Dictionary<string, ParentBlockersView>();

    private int ActiveCount => _runs.Count(run => run.Status.IsActive());

    protected override bool ReactsTo(LiveEventView liveEvent) => SpecQueueEvents.Affects(liveEvent);

    private IReadOnlyList<SpecRunView> RunsIn(SpecRunLane lane) =>
        _runs.Where(run => SpecRunLanes.For(run.Status) == lane).OrderBy(run => run.QueuePosition).ToArray();

    protected override async Task LoadAsync(CancellationToken cancellationToken)
    {
        int? repositoryId = RepositoryContext.CurrentRepositoryId;
        if (repositoryId is not { } id)
        {
            (_repository, _runs, _settings, _blockers) = (null, [], null, new Dictionary<string, ParentBlockersView>());
            return;
        }

        (_repository, _runs, _settings, _blockers) = await InScopeAsync<(RepositoryView?, IReadOnlyList<SpecRunView>, EffectiveSettingsView?, IReadOnlyDictionary<string, ParentBlockersView>)>(async services =>
        {
            RepositoryView? repository = await services.GetRequiredService<IRepositoryQueries>().GetAsync(id, cancellationToken);
            if (repository is null)
            {
                return (null, [], null, new Dictionary<string, ParentBlockersView>());
            }

            var queries = services.GetRequiredService<IRunQueries>();
            IReadOnlyList<SpecRunView> runs = await queries.ListSpecRunsAsync(id, cancellationToken);
            IReadOnlyDictionary<string, ParentBlockersView> blockers = await services.GetRequiredService<IParentBlockerQueries>().ListBlockersAsync(id, cancellationToken);
            CommandResult<EffectiveSettingsView> settings = await services.GetRequiredService<ISettingsManager>().GetEffectiveAsync(id, cancellationToken);
            return (repository, runs, settings.Value, blockers);
        });

        if (_repository is null)
        {
            // The selected repository no longer exists: forget it instead of showing a stale selection.
            RepositoryContext.ClearIfDangling([]);
        }
    }
}
